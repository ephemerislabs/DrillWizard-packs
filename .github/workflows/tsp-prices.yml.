# Drill Wizard — daily TSP share prices into latest.json
# Lives at .github/workflows/tsp-prices.yml in the DrillWizard-packs repo.
# Runs weekday evenings after tsp.gov posts the day's prices, plus a manual
# Run-workflow button for the first run and for catch-ups. The updater is
# fail-closed: a broken feed fails this job loudly and commits nothing.

name: TSP share prices

on:
  schedule:
    - cron: "30 23 * * 1-5"      # weekdays 23:30 UTC
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Parser self-test (no network)
        run: python3 update_tsp_prices.py --selftest

      - name: Fetch prices and update latest.json
        run: python3 update_tsp_prices.py

      - name: Commit if anything changed
        run: |
          set -euo pipefail
          if git diff --quiet -- latest.json; then
            echo "no change — nothing to commit"
            exit 0
          fi
          git config user.name  "dw-prices-bot"
          git config user.email "actions@users.noreply.github.com"
          git add latest.json
          git commit -m "TSP prices $(date -u +%F)"
          git push
